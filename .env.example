# ==========================================
# DRIVE LEGAL AI - BACKEND ENVIRONMENT CONFIG
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://127.0.0.1:5500

# Database
MONGO_URI=mongodb://127.0.0.1:27017/drive_legal_ai

# AI Service
AI_SERVER_URL=http://127.0.0.1:8000

# Auth
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TOO
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (AES-256-GCM key, 32 bytes hex-encoded = 64 hex chars)
ENCRYPTION_KEY=CHANGE_THIS_64_CHAR_HEX_STRING_0000000000000000000000000000

# Officer / Government Staff registration
STAFF_REGISTRATION_CODE=CHANGE_THIS_SECRET_CODE

# Payments (demo | live)
PAYMENT_MODE=demo
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# FASTag (demo | live)
FASTAG_MODE=demo
FASTAG_PROVIDER_API_KEY=

# Notifications (demo | live)
NOTIFICATION_MODE=demo
SMS_API_KEY=
SMS_SENDER_ID=DLAI
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Email (demo | live)
EMAIL_MODE=demo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@drivelegal.demo

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
